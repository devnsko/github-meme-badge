# Optional. A classic or fine-grained token with NO scopes is enough — it only
# raises the GitHub REST rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Absolute URL of the deployment, used for metadata and copyable snippets.
# On Vercel this is inferred automatically and can be left unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cloudflare R2, where generated badges are stored as SVG objects
# keyed by username. All four must be set — with any missing, the app simply
# generates every badge live and stores nothing. There is no database.
# Create an R2 API token with Object Read & Write for the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. Any S3-compatible endpoint (MinIO locally, for example).
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Optional. PUBLIC base URL of the bucket. When set, the copy-ready snippets
# point READMEs at Cloudflare's edge instead of this app.
#
# This is NOT the S3 API endpoint above. https://<account>.r2.cloudflarestorage.com
# always requires a signature, so a README embedding it shows bare link text.
# Turn on public access for the bucket (R2 > bucket > Settings > Public access)
# and use the r2.dev subdomain, or attach a custom domain. Neither includes the
# bucket name in the path — the host already identifies the bucket.
#   https://pub-0123456789abcdef.r2.dev
#   https://badges.example.com
R2_PUBLIC_BASE_URL=

# Optional. Runtime tracing of every read, write and cache decision. On by
# default in development; set to 1 to keep it on in production. The fields are
# keys, sizes, timings and status codes — no secrets.
BADGE_DEBUG=

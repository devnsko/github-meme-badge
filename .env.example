# Optional. A classic or fine-grained token with NO scopes is enough — it only
# raises the GitHub REST rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Absolute URL of the deployment, used for metadata and copyable snippets.
# On Vercel this is inferred automatically and can be left unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Cloudflare R2, where generated badges are stored as SVG objects
# keyed by username. All four must be set — with any missing, the app simply
# generates every badge live and stores nothing. There is no database.
# Create an R2 API token with Object Read & Write for the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. Any S3-compatible endpoint (MinIO locally, for example).
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Optional. Public base URL of the bucket (r2.dev or a custom domain), if you
# want READMEs to point at Cloudflare's edge instead of this app.
R2_PUBLIC_BASE_URL=
